# Copy this file to ~/.meal-organizer/.env and adjust the values.
# Never commit a real .env file or expose your OpenRouter API key.
MEAL_ORGANIZER_NAME=""
MEAL_ORGANIZER_SERVINGS=1
MEAL_ORGANIZER_WEEKLY_BUDGET=50
MEAL_ORGANIZER_ALLERGIES=""
MEAL_ORGANIZER_DISLIKES=""
MEAL_ORGANIZER_EQUIPMENT="oven,microwave,stovetop"

# Choose exactly one provider: ollama or openrouter
MEAL_ORGANIZER_LLM_PROVIDER=ollama

# Ollama
MEAL_ORGANIZER_OLLAMA_MODEL="qwen3:8b"
MEAL_ORGANIZER_OLLAMA_HOST="http://127.0.0.1:11434"

# OpenRouter
MEAL_ORGANIZER_OPENROUTER_MODEL=""
MEAL_ORGANIZER_OPENROUTER_API_KEY=""
